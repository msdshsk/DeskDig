<!--
    Theme: Dark。役割名のキーで配色を定める。Light.xaml と同じキー集合を持つこと（テストで検査する）。
    Freeze しない。切替は App のリソース辞書を差し替えることで行い、XAML 側は DynamicResource で参照する。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 地 -->
    <SolidColorBrush x:Key="Theme.Background" Color="#1F2229" />
    <!-- 面（タイル・行・パネル内の板） -->
    <SolidColorBrush x:Key="Theme.Surface" Color="#2B2F38" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#343A46" />
    <SolidColorBrush x:Key="Theme.SurfacePressed" Color="#3D4452" />
    <!-- 操作部品（平らなボタン・デバイス行・ComboBox など）の面 -->
    <SolidColorBrush x:Key="Theme.Control" Color="#262A33" />
    <!-- 罫線 -->
    <SolidColorBrush x:Key="Theme.Border" Color="#3A404C" />
    <SolidColorBrush x:Key="Theme.BorderStrong" Color="#4A5160" />
    <!-- 文字 -->
    <SolidColorBrush x:Key="Theme.Text" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#C9CDD4" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#9AA0AA" />
    <SolidColorBrush x:Key="Theme.TextHint" Color="#6C7380" />
    <!-- 入力欄 -->
    <SolidColorBrush x:Key="Theme.Input" Color="#14161B" />
    <!-- 強調（選択枠・既定の印・点灯） -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#61AFEF" />
    <SolidColorBrush x:Key="Theme.AccentSurface" Color="#2F4A66" />
    <SolidColorBrush x:Key="Theme.AccentBorderSoft" Color="#3A5A7A" />
    <!-- 警告 -->
    <SolidColorBrush x:Key="Theme.Warning" Color="#E5C07B" />
    <!-- PinnedApp のアイコン背景の板。Palette の面より一段明るく、黒で描かれたアイコンも見えるようにする -->
    <SolidColorBrush x:Key="Theme.IconPlate" Color="#363C49" />
    <SolidColorBrush x:Key="Theme.IconPlateHover" Color="#434A58" />

</ResourceDictionary>
