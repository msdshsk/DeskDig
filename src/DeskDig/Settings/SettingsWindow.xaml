<Window x:Class="DeskDig.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskDig.Settings"
        Title="DeskDig 設定" Width="640" Height="720" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <!-- 型ごとの編集部品。設定項目の宣言から行を生成し、ここは項目追加では触らない -->
        <DataTemplate x:Key="BoolEditor" DataType="{x:Type local:SettingRow}">
            <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="IntEditor" DataType="{x:Type local:SettingRow}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalContentAlignment="Right" />
        </DataTemplate>
        <DataTemplate x:Key="TextEditor" DataType="{x:Type local:SettingRow}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="220" />
        </DataTemplate>
        <DataTemplate x:Key="EnumEditor" DataType="{x:Type local:SettingRow}">
            <ComboBox ItemsSource="{Binding Options}" SelectedValue="{Binding Value}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="160" />
        </DataTemplate>
        <local:SettingEditorSelector x:Key="EditorSelector"
                                     Bool="{StaticResource BoolEditor}" Int="{StaticResource IntEditor}"
                                     Text="{StaticResource TextEditor}" Enum="{StaticResource EnumEditor}" />

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="96" Margin="0,0,8,0" Click="Save_Click" IsDefault="True" />
            <Button Content="キャンセル" Width="96" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="一般" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SettingRow}">
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11"
                                                   Visibility="{Binding HasDescription, Converter={x:Static local:SettingsWindow.BoolToVisibility}}" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource EditorSelector}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Heading}" Text="PlacementProfile" />
                <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,4"
                           Text="タイトル条件（部分一致）を追加できます。実行ファイルのみの規則とタイトル条件付きの規則が両方一致する場合はタイトル条件付きが優先されます。" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PlacementProfileRow}">
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExecutableName}" FontWeight="SemiBold" ToolTip="{Binding ExecutablePath}" />
                                        <TextBlock Text="{Binding PlacementText}" Foreground="Gray" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="タイトル条件:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding TitleCondition, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="削除" Width="64" Click="DeleteProfile_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="（記録された PlacementProfile はありません）" Foreground="Gray" Margin="4"
                           Visibility="{Binding HasNoProfiles, Converter={x:Static local:SettingsWindow.BoolToVisibility}}" />

                <TextBlock Style="{StaticResource Heading}" Text="Favorite" />
                <ItemsControl ItemsSource="{Binding Favorites}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FavoriteRow}">
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" ToolTip="{Binding ExecutablePath}" />
                                    <Button Grid.Column="1" Content="削除" Width="64" Click="DeleteFavorite_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="（Favorite はありません）" Foreground="Gray" Margin="4"
                           Visibility="{Binding HasNoFavorites, Converter={x:Static local:SettingsWindow.BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
