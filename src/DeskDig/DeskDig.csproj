<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DeskDig.ico</ApplicationIcon>
    <RootNamespace>DeskDig</RootNamespace>
    <AssemblyName>DeskDig</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version はリリース時にタグから -p:Version= で上書きされる -->
    <Version>0.5.0</Version>
    <Product>DeskDig</Product>
    <Authors>msd.shsk</Authors>
    <Company>msd.shsk</Company>
    <Copyright>Copyright (c) 2026 msd.shsk</Copyright>
    <Description>デスクトップのダブルクリックで埋もれたウインドウを掘り出す Windows 用の常駐ツール</Description>
    <RepositoryUrl>https://github.com/msdshsk/DeskDig</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>ja-JP</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms はトレイアイコンにだけ使う。暗黙 using は WPF 型と衝突するので外す -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskDig.Core\DeskDig.Core.csproj" />
  </ItemGroup>

</Project>
