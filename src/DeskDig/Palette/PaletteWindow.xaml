<Window x:Class="DeskDig.Palette.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskDig.Palette"
        Title="DeskDig"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Text}" FontSize="13"
        Width="1016" Height="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- 色は直書きせず、Themes/Dark.xaml・Light.xaml の役割名キーを DynamicResource で参照する（§4.10） -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <ContextMenu x:Key="EntryMenu">
            <MenuItem Header="{Binding FavoriteMenuLabel}" Click="ToggleFavorite_Click" />
            <Separator />
            <MenuItem Header="現在の配置を記録" Click="RecordPlacement_Click" />
            <MenuItem Header="配置を解除" Click="RemovePlacement_Click" IsEnabled="{Binding HasPlacement}" />
        </ContextMenu>

        <!-- タイル格子 -->
        <DataTemplate x:Key="GridTile" DataType="{x:Type local:WindowEntryItem}">
            <Border x:Name="Tile" Width="240" Margin="4" Padding="6" CornerRadius="6"
                    Background="{DynamicResource Theme.Surface}" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                    ContextMenu="{StaticResource EntryMenu}"
                    MouseLeftButtonUp="Entry_MouseLeftButtonUp"
                    MouseEnter="Entry_MouseEnter"
                    ContextMenuOpening="Entry_ContextMenuOpening">
                <StackPanel>
                    <Grid Height="130">
                        <local:ThumbnailSurface Source="{Binding Entry.Id}"
                                                Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding LargeIcon}" Width="72" Height="72"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,6,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Title}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 縦リスト -->
        <DataTemplate x:Key="ListRow" DataType="{x:Type local:WindowEntryItem}">
            <Border x:Name="Row" Margin="4,2" Padding="6" CornerRadius="6"
                    Background="{DynamicResource Theme.Surface}" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                    ContextMenu="{StaticResource EntryMenu}"
                    MouseLeftButtonUp="Entry_MouseLeftButtonUp"
                    MouseEnter="Entry_MouseEnter"
                    ContextMenuOpening="Entry_ContextMenuOpening">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="128" Height="72" Margin="0,0,10,0">
                        <local:ThumbnailSurface Source="{Binding Entry.Id}"
                                                Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding LargeIcon}" Width="48" Height="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                    <DockPanel VerticalAlignment="Center">
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,6,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Title}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <!-- 絞り込み行右端の SidePanel 開閉アイコン。Tag に「開いているか」を結び、開いている方を点灯させる -->
        <Style x:Key="SidePanelToggle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Theme.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.AccentSurface}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PinnedApp のセル。透過の上に黒や白で描かれたアイコンも見えるよう、Palette の面より一段強い対比の板（Theme.IconPlate）を常時敷く -->
        <DataTemplate x:Key="PinnedAppTile" DataType="{x:Type local:PinnedAppItem}">
            <Border x:Name="Cell" Width="40" Height="40" Margin="2" CornerRadius="5"
                    Background="{DynamicResource Theme.IconPlate}" BorderThickness="2" BorderBrush="Transparent"
                    ToolTip="{Binding Name}" Cursor="Hand" AllowDrop="True"
                    PreviewMouseLeftButtonDown="PinnedApp_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="PinnedApp_PreviewMouseMove"
                    MouseLeftButtonUp="PinnedApp_MouseLeftButtonUp"
                    MouseEnter="PinnedApp_MouseEnter"
                    DragOver="PinnedApp_DragOver"
                    Drop="PinnedApp_Drop">
                <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Theme.IconPlateHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Theme.IconPlateHover}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
      <DockPanel>
        <!-- 上端の帯。ここをドラッグすると Palette を移動できる（画面の上端近くで開いたときに手元へ引き寄せる用途） -->
        <Border DockPanel.Dock="Top" Height="14" Background="Transparent" Cursor="SizeAll" ToolTip="ドラッグで移動"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
            <Border Width="36" Height="4" CornerRadius="2" Background="{DynamicResource Theme.Border}" VerticalAlignment="Center" />
        </Border>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 絞り込み（右端に SidePanel の開閉アイコン: 操作 = ToolsPanel、歯車 = InfoPanel） -->
            <DockPanel Grid.Row="0" Margin="4,4,4,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource SidePanelToggle}" Content="&#xE713;" ToolTip="InfoPanel（歯車）"
                        Tag="{Binding IsInfoPanelOpen}" Click="InfoPanelToggle_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SidePanelToggle}" Content="&#xE90F;" ToolTip="ToolsPanel（操作）"
                        Tag="{Binding IsToolsPanelOpen}" Click="ToolsPanelToggle_Click" />
                <Grid>
                    <!-- IME を無効化: 変換中に Palette が隠れると WPF の TextStore が FailFast する既知の不具合を避ける -->
                    <TextBox x:Name="FilterBox" Padding="8,6" FontSize="14"
                             Background="{DynamicResource Theme.Input}" Foreground="{DynamicResource Theme.Text}"
                             BorderBrush="{DynamicResource Theme.Border}" CaretBrush="{DynamicResource Theme.Text}"
                             InputMethod.IsInputMethodEnabled="False"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextHint}"
                               Text="入力して絞り込み（アプリ名 / タイトル / PinnedApp）">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <!-- Launcher（PinnedApp の段） -->
            <StackPanel Grid.Row="1" Visibility="{Binding HasLauncherItems, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LauncherList" ItemsSource="{Binding LauncherItems}" ItemTemplate="{StaticResource PinnedAppTile}" Margin="2,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Margin="8,2,8,0" Height="18" Foreground="{DynamicResource Theme.TextMuted}" Text="{Binding SelectedPinnedAppName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource Theme.Border}" Margin="4,6,4,0" />

            <!-- WindowEntry 一覧 -->
            <ScrollViewer x:Name="EntryScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Favorite"
                               Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="FavoriteList" ItemsSource="{Binding FavoriteItems}" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="現在のデスクトップ"
                               Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="CurrentList" ItemsSource="{Binding CurrentItems}" />

                    <StackPanel Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}">
                        <Rectangle Height="1" Fill="{DynamicResource Theme.BorderStrong}" Margin="8,12,8,0" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="他のデスクトップ" />
                    </StackPanel>
                    <ItemsControl x:Name="OtherList" ItemsSource="{Binding OtherItems}" />

                    <TextBlock Margin="12,24" Foreground="{DynamicResource Theme.TextHint}" HorizontalAlignment="Center" Text="一致するウインドウはありません"
                               Visibility="{Binding HasAnyEntry, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
</Window>
