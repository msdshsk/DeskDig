<Window x:Class="DeskDig.Palette.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskDig.Palette"
        Title="DeskDig"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        Background="#1F2229" Foreground="#E6E6E6" FontSize="13"
        Width="1016" Height="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <ContextMenu x:Key="EntryMenu">
            <MenuItem Header="{Binding FavoriteMenuLabel}" Click="ToggleFavorite_Click" />
            <Separator />
            <MenuItem Header="現在の配置を記録" Click="RecordPlacement_Click" />
            <MenuItem Header="配置を解除" Click="RemovePlacement_Click" IsEnabled="{Binding HasPlacement}" />
        </ContextMenu>

        <!-- タイル格子 -->
        <DataTemplate x:Key="GridTile" DataType="{x:Type local:WindowEntryItem}">
            <Border x:Name="Tile" Width="240" Margin="4" Padding="6" CornerRadius="6"
                    Background="#2B2F38" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                    ContextMenu="{StaticResource EntryMenu}"
                    MouseLeftButtonUp="Entry_MouseLeftButtonUp"
                    MouseEnter="Entry_MouseEnter"
                    ContextMenuOpening="Entry_ContextMenuOpening">
                <StackPanel>
                    <Grid Height="130">
                        <local:ThumbnailSurface Source="{Binding Entry.Id}"
                                                Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding LargeIcon}" Width="72" Height="72"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,6,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Title}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#61AFEF" />
                    <Setter TargetName="Tile" Property="Background" Value="#343A46" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 縦リスト -->
        <DataTemplate x:Key="ListRow" DataType="{x:Type local:WindowEntryItem}">
            <Border x:Name="Row" Margin="4,2" Padding="6" CornerRadius="6"
                    Background="#2B2F38" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                    ContextMenu="{StaticResource EntryMenu}"
                    MouseLeftButtonUp="Entry_MouseLeftButtonUp"
                    MouseEnter="Entry_MouseEnter"
                    ContextMenuOpening="Entry_ContextMenuOpening">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="128" Height="72" Margin="0,0,10,0">
                        <local:ThumbnailSurface Source="{Binding Entry.Id}"
                                                Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding LargeIcon}" Width="48" Height="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                    <DockPanel VerticalAlignment="Center">
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,6,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Title}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="#61AFEF" />
                    <Setter TargetName="Row" Property="Background" Value="#343A46" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PinnedAppTile" DataType="{x:Type local:PinnedAppItem}">
            <Border x:Name="Cell" Width="40" Height="40" Margin="2" CornerRadius="5"
                    Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                    ToolTip="{Binding Name}" Cursor="Hand" AllowDrop="True"
                    PreviewMouseLeftButtonDown="PinnedApp_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="PinnedApp_PreviewMouseMove"
                    MouseLeftButtonUp="PinnedApp_MouseLeftButtonUp"
                    MouseEnter="PinnedApp_MouseEnter"
                    DragOver="PinnedApp_DragOver"
                    Drop="PinnedApp_Drop">
                <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="#343A46" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="#61AFEF" />
                    <Setter TargetName="Cell" Property="Background" Value="#343A46" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- SettingsShortcut: PinnedApp と区別するため、画像アイコンではなく記号フォントの小さなセル -->
        <DataTemplate x:Key="SettingsShortcutTile" DataType="{x:Type local:SettingsShortcutItem}">
            <Border x:Name="Cell" Height="30" Margin="2" Padding="8,0" CornerRadius="5"
                    Background="#262A33" BorderThickness="1" BorderBrush="#3A404C" Cursor="Hand"
                    ToolTip="{Binding Name}"
                    MouseLeftButtonUp="Shortcut_MouseLeftButtonUp"
                    MouseEnter="Shortcut_MouseEnter">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="#9AA0AA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#C9CDD4" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="#343A46" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="#61AFEF" />
                    <Setter TargetName="Cell" Property="Background" Value="#343A46" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#3A404C" BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 絞り込み -->
            <Grid Grid.Row="0" Margin="4,4,4,6">
                <!-- IME を無効化: 変換中に Palette が隠れると WPF の TextStore が FailFast する既知の不具合を避ける -->
                <TextBox x:Name="FilterBox" Padding="8,6" FontSize="14"
                         Background="#14161B" Foreground="#E6E6E6" BorderBrush="#3A404C" CaretBrush="#E6E6E6"
                         InputMethod.IsInputMethodEnabled="False"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6C7380"
                           Text="入力して絞り込み（アプリ名 / タイトル / PinnedApp）">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Launcher（PinnedApp の段と、その下の SettingsShortcut の段） -->
            <StackPanel Grid.Row="1" Visibility="{Binding HasLauncherSection, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LauncherList" ItemsSource="{Binding LauncherItems}" ItemTemplate="{StaticResource PinnedAppTile}" Margin="2,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding ShortcutItems}" ItemTemplate="{StaticResource SettingsShortcutTile}" Margin="2,2,2,0"
                              Visibility="{Binding HasShortcutItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Margin="8,2,8,0" Height="18" Foreground="#9AA0AA" Text="{Binding SelectedPinnedAppName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Rectangle Grid.Row="2" Height="1" Fill="#3A404C" Margin="4,6,4,0" />

            <!-- WindowEntry 一覧 -->
            <ScrollViewer x:Name="EntryScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Favorite"
                               Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="FavoriteList" ItemsSource="{Binding FavoriteItems}" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="現在のデスクトップ"
                               Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="CurrentList" ItemsSource="{Binding CurrentItems}" />

                    <StackPanel Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}">
                        <Rectangle Height="1" Fill="#4A5160" Margin="8,12,8,0" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="他のデスクトップ" />
                    </StackPanel>
                    <ItemsControl x:Name="OtherList" ItemsSource="{Binding OtherItems}" />

                    <TextBlock Margin="12,24" Foreground="#6C7380" HorizontalAlignment="Center" Text="一致するウインドウはありません"
                               Visibility="{Binding HasAnyEntry, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
