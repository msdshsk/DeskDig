<Window x:Class="DeskDig.Palette.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskDig.Palette"
        Title="DeskDig SidePanel"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Text}" FontSize="13"
        Width="320" Height="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- 色は直書きせず、Themes/Dark.xaml・Light.xaml の役割名キーを DynamicResource で参照する（§4.10） -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="4,10,4,4" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 平らなボタン。マウス前提なのでフォーカス枠は出さない -->
        <Style x:Key="FlatButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="{DynamicResource Theme.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatToggle" TargetType="ToggleButton" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.AccentSurface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ShortcutButton" DataType="{x:Type local:SettingsShortcutItem}">
            <Button Style="{StaticResource FlatButton}" Margin="2" ToolTip="{Binding Name}" Click="Shortcut_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource Theme.TextMuted}" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DeviceRow" DataType="{x:Type local:AudioDeviceItem}">
            <Border x:Name="Row" Margin="2,1" Padding="8,5" CornerRadius="5" Background="{DynamicResource Theme.Control}" BorderThickness="1" BorderBrush="Transparent"
                    Cursor="Hand" MouseLeftButtonUp="Device_MouseLeftButtonUp" ToolTip="{Binding Name}">
                <DockPanel>
                    <TextBlock x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE73E;" Width="18" FontSize="13"
                               Foreground="{DynamicResource Theme.Accent}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="Spacer" DockPanel.Dock="Left" Width="18" Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Theme.AccentBorderSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SummaryRow" DataType="{x:Type local:SummaryLine}">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="12" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
        <Grid Margin="8">
            <!-- ================= ToolsPanel ================= -->
            <DockPanel Visibility="{Binding IsTools, Converter={StaticResource BoolToVis}}">
                <!-- 上段: AlwaysShown のピン型ボタンと SettingsShortcut -->
                <DockPanel DockPanel.Dock="Top" Margin="4,4,4,0">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource FlatToggle}" Padding="7,5"
                                  IsChecked="{Binding AlwaysShown, Mode=TwoWay}" Checked="AlwaysShown_Changed" Unchecked="AlwaysShown_Changed"
                                  ToolTip="Palette を開くたびに ToolsPanel も開く（AlwaysShown）">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="14">
                            <TextBlock.Text>
                                <Binding Path="AlwaysShown">
                                    <Binding.Converter>
                                        <local:AlwaysShownGlyphConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                    </ToggleButton>
                    <TextBlock Text="ToolsPanel" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Shortcuts}" ItemTemplate="{StaticResource ShortcutButton}" Margin="2,6,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Theme.Border}" Margin="4,10,4,0" />

                <!-- 退避ボタン（下に固定。既定の切替に失敗したときだけ出る） -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Margin="4,8,4,4" HorizontalContentAlignment="Center"
                        Click="SoundFallback_Click"
                        Visibility="{Binding ShowSoundFallback, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Theme.Warning}" FontSize="13" />
                        <TextBlock Text="切替に失敗しました。サウンドの設定を開く" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- 本体: AudioControl。出力（スピーカー）と入力（マイク）を独立した段で並べ、それぞれ既定の切替・音量・ミュートを持つ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 出力 -->
                        <StackPanel DataContext="{Binding Output}">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}" />
                            <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRow}" />
                            <TextBlock Margin="8,8" Foreground="{DynamicResource Theme.TextHint}" HorizontalAlignment="Center" Text="{Binding EmptyText}"
                                       Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVis}}" />
                            <DockPanel Margin="4,6,4,0" IsEnabled="{Binding HasDefaultDevice}">
                                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FlatToggle}" Padding="7,5" Width="34" HorizontalContentAlignment="Center"
                                              IsChecked="{Binding IsMuted, Mode=TwoWay}" Checked="OutputMute_Changed" Unchecked="OutputMute_Changed" ToolTip="出力をミュート">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MuteGlyph}" FontSize="14" />
                                </ToggleButton>
                                <TextBlock DockPanel.Dock="Right" Width="34" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.TextMuted}"
                                           Text="{Binding Volume, StringFormat={}{0:0}}" />
                                <Slider Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center" IsMoveToPointEnabled="True" Focusable="False"
                                        Value="{Binding Volume, Mode=TwoWay}" ValueChanged="OutputVolume_ValueChanged" />
                            </DockPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Border}" Margin="4,12,4,0" />

                        <!-- 入力 -->
                        <StackPanel DataContext="{Binding Input}">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}" />
                            <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRow}" />
                            <TextBlock Margin="8,8" Foreground="{DynamicResource Theme.TextHint}" HorizontalAlignment="Center" Text="{Binding EmptyText}"
                                       Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVis}}" />
                            <DockPanel Margin="4,6,4,0" IsEnabled="{Binding HasDefaultDevice}">
                                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FlatToggle}" Padding="7,5" Width="34" HorizontalContentAlignment="Center"
                                              IsChecked="{Binding IsMuted, Mode=TwoWay}" Checked="InputMute_Changed" Unchecked="InputMute_Changed" ToolTip="マイクをミュート">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MuteGlyph}" FontSize="14" />
                                </ToggleButton>
                                <TextBlock DockPanel.Dock="Right" Width="34" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Theme.TextMuted}"
                                           Text="{Binding Volume, StringFormat={}{0:0}}" />
                                <Slider Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center" IsMoveToPointEnabled="True" Focusable="False"
                                        Value="{Binding Volume, Mode=TwoWay}" ValueChanged="InputVolume_ValueChanged" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ================= InfoPanel ================= -->
            <DockPanel Visibility="{Binding IsInfo, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="InfoPanel" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" Margin="4,4,4,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- SystemSummary -->
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="8,3" Margin="4,0" Click="CopySummary_Click" ToolTip="プレーンテキストとしてクリップボードへ">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="コピー" FontSize="12" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SystemSummary" VerticalAlignment="Center" Margin="4,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SummaryLines}" ItemTemplate="{StaticResource SummaryRow}" Margin="0,6,0,0" />

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Border}" Margin="4,12,4,0" />

                        <!-- DeskDig の設定 -->
                        <TextBlock Style="{StaticResource SectionLabel}" Text="DeskDig の設定" />
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="ホットキー" Foreground="{DynamicResource Theme.TextMuted}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding HotkeyText}" FontSize="12" />
                            <TextBlock Grid.Row="1" Text="Trigger" Foreground="{DynamicResource Theme.TextMuted}" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TriggerText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <!-- Theme（§4.10）。選ぶと即時に反映し、設定として保存する。設定画面の「テーマ」と同じ値 -->
                            <TextBlock Grid.Row="2" Text="テーマ" Foreground="{DynamicResource Theme.TextMuted}" FontSize="12" Margin="0,10,0,0" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" FontSize="12" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0"
                                      ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Theme, Mode=TwoWay}" SelectionChanged="Theme_SelectionChanged"
                                      ToolTip="Dark / Light / System（Windows のアプリモードに追従）" />
                        </Grid>
                        <Button Style="{StaticResource FlatButton}" Margin="4,10,4,0" HorizontalContentAlignment="Center" Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="13" />
                                <TextBlock Text="設定画面を開く" FontSize="12" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
